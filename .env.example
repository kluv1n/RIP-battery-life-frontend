# Dev: прокси Vite → localhost:8080
VITE_API_BASE_URL=/api

# Tauri / LAN-сборка — см. также .env.production.example → .env.production.local
# VITE_API_ORIGIN=http://192.168.1.222:8080
# VITE_MINIO_PUBLIC_BASE=http://192.168.1.222:9000/batteries

# Без пересборки (Tauri release / GitHub Pages), в консоли webview:
# localStorage.setItem("rip.apiOrigin", "http://192.168.1.222:8080");
# localStorage.setItem("rip.minioOrigin", "http://192.168.1.222:9000");
# location.reload();

# GitHub Pages в браузере без пересборки (только production, не npm run dev):
# localStorage.setItem("rip.apiOrigin", "http://192.168.56.1:8080"); location.reload();

# Прокси Vite dev (обычно localhost:8080)
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_MINIO_PROXY_TARGET=http://localhost:9000

# GitHub Pages: имя репозитория, например /RIP-battery-life-frontend/
# VITE_BASE_PATH=/RIP-battery-life-frontend/

# MinIO / медиа
# VITE_MINIO_BASE=/minio/test
# VITE_MEDIA_BASE=http://localhost:9000/test

# Локальный HTTPS (npm run dev:https)
# VITE_DEV_HTTPS=true

# Сборка гостевого Tauri (3 страницы, без авторизации)
# VITE_GUEST_APP=true
