# Tauri: правьте .env.tauri (или .env.tauri.local в .gitignore), затем npm run build:tauri
# Pages: .env.pages уже с VITE_BASE_PATH=/RIP-battery-life-frontend/ — npm run deploy:gh-pages

# Пример .env.tauri.local (не коммитить IP):
# VITE_TAURI_USE_LAN_IP=true
# VITE_API_ORIGIN=http://192.168.1.222:8080
# VITE_MINIO_PUBLIC_BASE=http://192.168.1.222:9000/batteries
