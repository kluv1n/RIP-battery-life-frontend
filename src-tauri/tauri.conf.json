{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Battery Life Guest",
  "version": "0.1.0",
  "identifier": "com.rip.batterylife.guest",
  "build": {
    "beforeDevCommand": "npm run dev:guest",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Battery Life — гость",
        "width": 1100,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
