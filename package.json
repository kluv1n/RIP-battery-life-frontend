{
  "name": "rip2026_lab5_front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "VITE_DEV_HTTPS=true vite",
    "dev:https:certs": "bash scripts/gen-https-certs.sh",
    "dev:guest": "VITE_GUEST_APP=true vite",
    "build": "tsc -b && vite build",
    "build:tauri": "tsc -b && vite build --mode tauri",
    "build:guest": "cross-env VITE_GUEST_APP=true tsc -b && cross-env VITE_GUEST_APP=true vite build",
    "build:pages": "node scripts/write-pages-build-id.mjs && tsc -b && vite build --mode pages && cp dist/index.html dist/404.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:gh-pages": "npm run build:pages && gh-pages -d dist --dotfiles",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:autoip": "bash scripts/tauri-dev-autoip.sh",
    "tauri:dev:lan": "cross-env VITE_API_ORIGIN=http://192.168.56.1:8080 VITE_MINIO_PUBLIC_BASE=http://192.168.56.1:9000/batteries npm run tauri:dev",
    "tauri:build": "npm run build:tauri && tauri build",
    "tauri:build:app": "npm run build:tauri && tauri build --bundles app",
    "tauri:open": "bash scripts/tauri-open-app.sh",
    "zerotier:lab": "bash scripts/zerotier-lab-setup.sh",
    "zerotier:status": "bash scripts/zerotier-status.sh",
    "zerotier:join": "bash scripts/zerotier-join.sh",
    "zerotier:apply": "bash scripts/zerotier-apply-env.sh",
    "tauri:run": "bash scripts/tauri-set-ip.sh && npm run tauri:build:app && npm run tauri:open",
    "tauri:run:zt": "npm run zerotier:apply && npm run tauri:build:app && npm run tauri:open",
    "tauri:build:lan": "cross-env VITE_API_ORIGIN=http://192.168.56.1:8080 VITE_MINIO_PUBLIC_BASE=http://192.168.56.1:9000/batteries npm run build:tauri && tauri build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "@reduxjs/toolkit": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.9",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.8",
    "react": "^19.1.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-pwa": "^1.0.1"
  }
}
